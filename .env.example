# Copie este ficheiro para .env e preencha com as suas chaves.
# NUNCA versione o ficheiro .env - o .gitignore ja o protege.

# Chave do LLM (Groq) - obrigatoria
GROQ_API_KEY_LLM=

# Chave do modelo de visao (Groq) - obrigatoria
GROQ_API_KEY_VISION=

# Chave NVIDIA - so e necessaria se o provedor ativo no brain.json for "nvidia"
NVIDIA_API_KEY=

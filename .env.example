# Copie este ficheiro para .env e preencha com as suas chaves.
# NUNCA versione o ficheiro .env - o .gitignore ja o protege.

# Chave do LLM (Groq) - obrigatoria
GROQ_API_KEY_LLM=

# Chave do modelo de visao (Groq) - so precisa se VISAO_PROVEDOR=groq
GROQ_API_KEY_VISION=

# Chave NVIDIA - so e necessaria se o provedor ativo no brain.json for "nvidia"
NVIDIA_API_KEY=

# 👁️ Visao: "groq" (cloud) ou "local" (Ollama em http://localhost:11434/v1)
VISAO_PROVEDOR=groq

# So usado quando VISAO_PROVEDOR=local. Aponta para o Ollama ou o LM Studio.
VISAO_BASE_URL=http://localhost:11434/v1

# Modelo de visao. Sem valor, usa o certo para cada modo.
# Locais que cabem em 16 GB de RAM sem GPU NVIDIA:
#   qwen2.5vl:3b      leve e razoavel (recomendado)
#   moondream         o mais leve, so para o ecra
#   llama3.2-vision:11b  pesado, so com o resto do sistema fechado
#VISAO_MODELO=qwen2.5vl:3b

# O Ollama ignora a chave, mas a API exige que exista um valor.
#VISAO_API_KEY=ollama

# Ferramentas: 0 = tags de texto (estavel, omissao), 1 = function calling nativo.
# Com 1 o modelo decide acoes por tool calling em vez de escrever <COMPUTER:...>.
# Nao testado contra modelos reais ainda - so com um cliente falso.
#MODO_FERRAMENTAS=0
